#!/usr/bin/env node
import { parseArgs } from 'node:util'
import { resolve } from 'node:path'
import { setTimeout as sleep } from 'node:timers/promises'
import { enter } from '../lib/enter.mjs'
import { call, ready } from '../lib/client.mjs'
import { platform } from '../lib/platform/index.mjs'
import { Store } from '../lib/store.mjs'

const help = [
  'cc-bro      Open this project’s manager in the current terminal',
  'cc-bro ui [--no-open]',
  'cc-bro done <name>',
  'cc-bro say <name> <message> [--model provider/id] [--title title] [--cwd dir] [--bg] [--json]',
  'cc-bro ls [--json]',
  'cc-bro show <name> [--all] [--json]',
  'cc-bro watch',
  'cc-bro wait <name> <turn> [--json]',
  'cc-bro stop <name>',
  'cc-bro shutdown'
].join('\n')

function table(store) {
  const rows = store.list()
  function seconds(r) {
    return r.started ? Math.max(0, Math.floor(((r.finished ?? Date.now()) - r.started) / 1000)) : 0
  }
  return ['NAME\tMODEL\tDIRECTORY\tSTATUS\tTURN\tELAPSED\tACTIVITY', ...rows.map(r =>
    [r.name, r.model, r.cwd, r.status, r.turn, seconds(r) + 's', r.activity].join('\t'))].join('\n')
}

function convo(store, name) {
  const c = store.byName(name)
  if (!c) throw new Error('Unknown conversation: ' + name)
  return c
}

async function recoverIfDead(runner) {
  try { process.kill(runner.pid, 0); return runner }
  catch (err) {
    if (err.code !== 'ESRCH') throw err
    return ready()
  }
}

async function waitFor(store, name, turn, number, runner) {
  const c = convo(store, name)
  for (;;) {
    const result = store.result(c.id, turn)
    if (number) {
      const message = store.stmt('SELECT error FROM messages WHERE cid=? AND number=?').get(c.id, number)
      if (message?.error) throw new Error(message.error)
    }
    if (!['running', 'queued'].includes(result.status)) return result
    runner = await recoverIfDead(runner)
    await sleep(140)
  }
}

async function watch(store, runner) {
  const initial = store.transaction(() => ({
    cursor: store.stmt('SELECT coalesce(max(id),0) AS id FROM events').get().id,
    board: table(store)
  }))
  let cursor = initial.cursor
  console.log(initial.board)
  for (;;) {
    await sleep(140)
    const batch = store.stmt('SELECT e.id,c.name,e.turn,e.summary FROM events e JOIN conversations c ON e.cid=c.id WHERE e.id>? ORDER BY e.id LIMIT 512').all(cursor)
    if (!batch.length) {
      if (store.stmt("SELECT 1 FROM conversations WHERE status='running' LIMIT 1").get()) runner = await recoverIfDead(runner)
      continue
    }
    cursor = batch.at(-1).id
    const events = batch.filter(e => e.summary)
    if (!events.length) continue
    if (process.stdout.isTTY) process.stdout.write('\x1b[2J\x1b[H' + table(store) + '\n\n')
    for (const e of events) console.log(e.name + ' #' + e.turn + '  ' + e.summary)
  }
}

async function main() {
  const [cmd, ...args] = process.argv.slice(2)
  if (!cmd) return enter()
  if (['-h', '--help', 'help'].includes(cmd)) return console.log(help)
  const specs = { ui: [0, 'no-open'], done: [1, 'json'], say: [2, 'title', 'model', 'cwd', 'bg', 'json'], ls: [0, 'json'], show: [1, 'all', 'json'],
    watch: [0], wait: [2, 'json'], stop: [1, 'json'], shutdown: [0] }
  if (!Object.hasOwn(specs, cmd)) throw new Error(help)
  const [count, ...flags] = specs[cmd]
  const options = Object.fromEntries(flags.map(k => [k, { type: ['model', 'cwd', 'title'].includes(k) ? 'string' : 'boolean' }]))
  const { values: opt, positionals } = parseArgs({ args, options, allowPositionals: true })
  if (positionals.length !== count) throw new Error(help)
  const [name, argument] = positionals
  const runner = await ready(cmd !== 'ui')
  if (cmd === 'ui') {
    const { url } = await call('/ui', {})
    if (!opt['no-open']) await platform.openBrowser(url)
    return console.log(url)
  }
  if (cmd === 'shutdown') { await call('/shutdown', {}); await platform.removeService(); return console.log('Runner stopped') }
  const { projectId, database, defaultCwd } = await call('/context', { cwd: process.cwd() })
  const store = new Store(true, database)
  try {
    if (cmd === 'ls' && projectId) {
      const tickets = store.ticketRows()
      return console.log(opt.json ? JSON.stringify(tickets) : ['TICKET\tTITLE\tSTATUS\tFLAG\tMODEL\tACTIVITY', ...tickets.map(t =>
        [t.id, t.title, t.status, t.flag || '-', t.model, t.activity].join('\t'))].join('\n'))
    }
    if (cmd === 'ls') return console.log(opt.json ? JSON.stringify(store.list()) : table(store))
    if (cmd === 'watch') return await watch(store, runner)
    if (cmd === 'done') {
      const ticket = await call('/done', { name, projectId })
      return console.log(opt.json ? JSON.stringify(ticket) : name + ' accepted')
    }
    if (cmd === 'stop') {
      const result = await call('/stop', { name, projectId })
      return console.log(opt.json ? JSON.stringify(result) : name + ' stopped; processes verified' + (result.forced ? ' (forced)' : ''))
    }
    if (cmd === 'show') {
      const c = convo(store, name)
      if (opt.all) {
        const rows = store.history(c.id)
        return console.log(opt.json ? JSON.stringify(rows) : rows.map(m =>
          '[' + m.turn + '] ' + m.kind + (m.number ? ' #' + m.number : '') + ': ' + m.content + (m.error ? ' [' + m.error + ']' : '')).join('\n'))
      }
      const reply = store.stmt("SELECT content FROM messages WHERE cid=? AND kind='reply' ORDER BY id DESC LIMIT 1").get(c.id)?.content
      return console.log(opt.json ? JSON.stringify({ name, status: c.status, reply: reply ?? null }) : reply ?? 'No reply yet (' + c.activity + ')')
    }
    let receipt
    if (cmd === 'say') {
      receipt = await call('/say', { name, projectId, title: opt.title, text: argument, model: opt.model, cwd: opt.cwd && resolve(opt.cwd), defaultCwd })
      const ack = name + ' message #' + receipt.number + ', turn ' + receipt.turn +
        (receipt.kind === 'steer' ? ' (steer accepted into current turn)' : receipt.kind === 'queued' ? ' (queued)' : ' (prompt accepted)')
      if (opt.bg) return console.log(opt.json ? JSON.stringify(receipt) : ack)
      if (!opt.json) console.error(ack)
    }
    const turn = receipt?.turn ?? Number(argument)
    if (!Number.isSafeInteger(turn) || turn < 1) throw new Error('Expected a positive turn number')
    const result = await waitFor(store, name, turn, receipt?.number, runner)
    if (opt.json) console.log(JSON.stringify({ name, ...receipt, ...result }))
    else if (result.reply) console.log(result.reply)
    if (result.status !== 'done') throw new Error(result.error || result.status)
  } finally { store.db.close() }
}

process.stdout.on('error', err => { if (err.code === 'EPIPE') process.exit(0); throw err })
main().catch(err => { console.error(err.message); process.exitCode = 1 })
