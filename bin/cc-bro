#!/usr/bin/env node
import { createInterface } from 'node:readline/promises'
import { chooseAllow, chooseDefault } from '../lib/worker-policy.mjs'
import { parseArgs } from 'node:util'
import { setTimeout as sleep } from 'node:timers/promises'
import { modelVariables } from '../lib/model-env.mjs'
import { setup } from '../lib/setup.mjs'
import { call, ready, shutdown, shutdownEffect } from '../lib/client.mjs'
import { platform } from '../lib/platform/index.mjs'
import { Store } from '../lib/store.mjs'

const help = [
  'cc-bro setup      Install or update the user skill',
  'cc-bro init [--allow worker,worker] [--default-worker worker]',
  'cc-bro ui [--no-open]',
  'cc-bro roster [--json]    Inspect allowed workers before dispatch',
  'cc-bro note <worker> <text> [--json]    Propose a note for user confirmation',
  'cc-bro done <name>',
  'cc-bro say <name> <message> [--worktree] [--model id] [--effort level] [--title title] [--worker id] [--bg] [--json]',
  'cc-bro review <name> --by worker [--model id] [--effort level] [--bg] [--json]',
  'cc-bro ls [--json]',
  'cc-bro show <name> [--all] [--json]',
  'cc-bro watch',
  'cc-bro wait <name> <turn> [--json]',
  'cc-bro stop <name>',
  'cc-bro shutdown   Stop the runner, including running and queued work'
].join('\n')

function table(store) {
  const rows = store.list()
  function seconds(r) {
    return r.started ? Math.max(0, Math.floor(((r.finished ?? Date.now()) - r.started) / 1000)) : 0
  }
  return ['NAME\tMODEL\tDIRECTORY\tSTATUS\tTURN\tELAPSED\tACTIVITY', ...rows.map(r =>
    [r.name, r.model, r.cwd, r.status, r.turn, seconds(r) + 's', r.activity].join('\t'))].join('\n')
}

function convo(store, name) {
  const c = store.byName(name)
  if (!c) throw new Error('Unknown conversation: ' + name)
  return c
}

async function recoverIfDead(runner) {
  try { process.kill(runner.pid, 0); return runner }
  catch (err) {
    if (err.code !== 'ESRCH') throw err
    return ready()
  }
}

async function waitFor(store, name, turn, number, runner) {
  const c = convo(store, name)
  for (;;) {
    const result = store.result(c.id, turn)
    if (number) {
      const message = store.stmt('SELECT error FROM messages WHERE cid=? AND number=?').get(c.id, number)
      if (message?.error) throw new Error(message.error)
    }
    if (!['running', 'queued'].includes(result.status)) return result
    runner = await recoverIfDead(runner)
    await sleep(140)
  }
}

async function watch(store, runner) {
  const initial = store.transaction(() => ({
    cursor: store.stmt('SELECT coalesce(max(id),0) AS id FROM events').get().id,
    board: table(store)
  }))
  let cursor = initial.cursor
  console.log(initial.board)
  for (;;) {
    await sleep(140)
    const batch = store.stmt('SELECT e.id,c.name,e.turn,e.summary FROM events e JOIN conversations c ON e.cid=c.id WHERE e.id>? ORDER BY e.id LIMIT 512').all(cursor)
    if (!batch.length) {
      if (store.stmt("SELECT 1 FROM conversations WHERE status='running' LIMIT 1").get()) runner = await recoverIfDead(runner)
      continue
    }
    cursor = batch.at(-1).id
    const events = batch.filter(e => e.summary)
    if (!events.length) continue
    if (process.stdout.isTTY) process.stdout.write('\x1b[2J\x1b[H' + table(store) + '\n\n')
    for (const e of events) console.log(e.name + ' #' + e.turn + '  ' + e.summary)
  }
}

async function main() {
  const [cmd, ...args] = process.argv.slice(2)
  if (cmd === 'setup' && !args.length) return console.log(setup())
  if (!cmd) return console.log(help)
  if (['-h', '--help', 'help'].includes(cmd)) return console.log(help)
  const specs = { init: [0, 'allow', 'default-worker', 'json'], ui: [0, 'no-open'], roster: [0, 'json'], note: [2, 'json'], done: [1, 'json'], review: [1,'by','model','effort','bg','json'], say: [2, 'worktree', 'title', 'model', 'effort', 'worker', 'bg', 'json'], ls: [0, 'json'], show: [1, 'all', 'json'],
    watch: [0], wait: [2, 'json'], stop: [1, 'json'], shutdown: [0] }
  if (!Object.hasOwn(specs, cmd)) throw new Error(help)
  const [count, ...flags] = specs[cmd]
  const options = Object.fromEntries(flags.map(k => [k, { type: ['model', 'effort', 'worker', 'by', 'title', 'allow', 'default-worker'].includes(k) ? 'string' : 'boolean' }]))
  const { values: opt, positionals } = parseArgs({ args, options, allowPositionals: true })
  if (positionals.length !== count) throw new Error(help)
  const [name, argument] = positionals
  if (cmd === 'shutdown') {
    console.error(shutdownEffect)
    await shutdown()
    return console.log('Runner stopped')
  }
  const runner = await ready()
  if (cmd === 'init') {
    const input = { cwd: process.cwd(), allow: opt.allow, worker: opt['default-worker'] }
    let p
    for (;;) {
      try { p = await call('/register', input); break } catch (err) {
        if (!process.stdin.isTTY || ![chooseAllow, chooseDefault].includes(err.message)) throw err
        const reader = createInterface({ input: process.stdin, output: process.stderr })
        try {
          if (err.message === chooseAllow) input.allow = await reader.question('Allowed workers (codex, pi:<provider>, agy, cursor-agent, custom:<name>; comma-separated): ')
          else input.worker = await reader.question('Default worker from the allowed list: ')
        } finally { reader.close() }
      }
    }
    return console.log(opt.json ? JSON.stringify(p) : p.name + ': ' + p.allow.join(', ') + ' (default: ' + p.worker + ')')
  }
  if (cmd === 'ui') {
    const { url } = await call('/ui', {})
    if (!opt['no-open']) await platform.openBrowser(url)
    return console.log(url)
  }
  const { projectId, database, defaultCwd } = await call('/context', { cwd: process.cwd() })
  if (cmd === 'roster') {
    const roster = await call('/roster', { projectId })
    return console.log(opt.json ? JSON.stringify(roster) : ['Default bro: ' + roster.defaultWorker, ...roster.workers.map(w => [
      '\n' + w.id + ' · ' + w.capability + ' · ' + w.cli + ' ' + (w.version || 'unknown version'),
      'Installed: ' + w.installed + ' · Login: ' + w.loginStatus + ' · Steering: ' + w.steering,
      'Default model: ' + (w.defaultModel || 'CLI default') + ' · Effort: ' + (w.defaultEffort || 'CLI default'),
      'Models: ' + w.models.map(m => m.id + (m.efforts?.length ? ' [' + m.efforts.join(', ') + ']' : '')).join(', '),
      'Note: ' + (w.note || '—'), ...w.rules.map(r => 'Rule: ' + r), ...w.warnings.map(r => 'Notice: ' + r)
    ].join('\n'))].join('\n'))
  }
  if (cmd === 'note') {
    const proposal = await call('/note-proposal', { projectId, worker: name, note: argument })
    return console.log(opt.json ? JSON.stringify(proposal) : 'Note proposed; the user must confirm it in cc-bro ui → Settings.')
  }
  const store = new Store(true, database)
  try {
    if (cmd === 'ls') {
      const tickets = store.ticketRows()
      return console.log(opt.json ? JSON.stringify(tickets) : ['TICKET\tTITLE\tSTATUS\tFLAG\tMODEL\tACTIVITY', ...tickets.map(t =>
        [t.id, t.title, t.status, t.flag || '-', t.model, t.activity].join('\t'))].join('\n'))
    }
    if (cmd === 'watch') return await watch(store, runner)
    if (cmd === 'done') {
      const ticket = await call('/done', { name, projectId })
      return console.log(opt.json ? JSON.stringify(ticket) : [name + ' accepted', ticket.cleanupHint].filter(Boolean).join('\n'))
    }
    if (cmd === 'stop') {
      const result = await call('/stop', { name, projectId })
      return console.log(opt.json ? JSON.stringify(result) : name + ' stopped; processes verified' + (result.forced ? ' (forced)' : ''))
    }
    if (cmd === 'show') {
      const c = convo(store, name)
      if (opt.all) {
        const rows = store.history(c.id)
        return console.log(opt.json ? JSON.stringify(rows) : rows.map(m =>
          '[' + m.turn + '] ' + m.kind + (m.number ? ' #' + m.number : '') + ': ' + m.content + (m.error ? ' [' + m.error + ']' : '')).join('\n'))
      }
      const result = store.result(c.id, c.turn)
      const out = { ...store.detail(name), name, provider: c.provider, session: c.native_id, transport: c.transport, ...result }
      return console.log(opt.json ? JSON.stringify(out) : [result.reply ?? result.error ?? c.activity, result.cachedInputTokens === null ? null : 'Cached input: ' + result.cachedInputTokens + ' tokens'].filter(Boolean).join('\n'))
    }
    let receipt
    if (cmd === 'say' || cmd === 'review') {
      receipt = cmd === 'review'
        ? await call('/review', { name, by: opt.by, model: opt.model, effort: opt.effort, projectId, env: modelVariables(process.env) })
        : await call('/say', { name, projectId, env: modelVariables(process.env), title: opt.title, text: argument, model: opt.model, effort: opt.effort, worker: opt.worker, defaultCwd, worktree: opt.worktree })
      const labels = { injected: '已注入 / injected', queued: '排到下一轮 / queued for next turn', rejected: '被拒 / rejected' }
      const ack = receipt.name + ' message #' + receipt.number + ', turn ' + receipt.turn + ' (' +
        (labels[receipt.outcome] || (receipt.kind === 'queued' ? 'queued' : 'prompt accepted')) + ')' + (receipt.reason ? ': ' + receipt.reason : '') +
        '\n' + receipt.worker + ' · ' + receipt.model + (receipt.effort ? ' · ' + receipt.effort : '') +
        (receipt.note ? '\nNote: ' + receipt.note : '') + (receipt.reminders?.length ? '\n' + receipt.reminders.join('\n') : '')
      if (receipt.outcome === 'rejected') {
        process.exitCode = 1
        return console.log(opt.json ? JSON.stringify(receipt) : ack)
      }
      if (opt.bg) return console.log(opt.json ? JSON.stringify(receipt) : ack)
      if (!opt.json) console.error(ack)
    }
    const turn = receipt?.turn ?? Number(argument)
    if (!Number.isSafeInteger(turn) || turn < 1) throw new Error('Expected a positive turn number')
    const result = await waitFor(store, receipt?.name ?? name, turn, receipt?.number, runner)
    if (opt.json) console.log(JSON.stringify({ name, ...receipt, ...result }))
    else if (result.reply) console.log(result.reply)
    if (result.status !== 'done') throw new Error(result.error || result.status)
  } finally { store.db.close() }
}

process.stdout.on('error', err => { if (err.code === 'EPIPE') process.exit(0); throw err })
main().catch(err => { console.error(err.message); process.exitCode = 1 })
